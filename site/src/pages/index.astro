---
import { getCollection } from "astro:content";
import EmptyFeedState from "@/components/EmptyFeedState.astro";
import AppcastDownloadWidget from "@/components/AppcastDownloadWidget.astro";
import FilterBar from "@/components/FilterBar.astro";
import ReleaseDeltaPanel from "@/components/ReleaseDeltaPanel.astro";
import ResetStatusWidget from "@/components/ResetStatusWidget.astro";
import SignalCard from "@/components/SignalCard.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type ReleaseDeltaData } from "@/lib/release-delta";
import {
  FILTERS,
  groupSignalsByMonth,
  isFilterId,
  sortSignals,
  type FilterId,
  type SignalCardData,
} from "@/lib/signal-feed";

const rawFilter = Astro.url.searchParams.get("filter");
const activeFilter: FilterId = isFilterId(rawFilter) ? rawFilter : "all";
const collectionEntries = await getCollection("signals");
const releaseDeltaEntries = await getCollection("releaseDeltas");
const recommendedConfigEntries = await getCollection("recommendedConfigs");
const signals: SignalCardData[] = sortSignals(
  collectionEntries.map((entry) => ({
    id: entry.id,
    ...entry.data,
  })),
);
const releaseDelta: ReleaseDeltaData | null =
  releaseDeltaEntries
    .map((entry) => entry.data as ReleaseDeltaData)
    .find((entry) => entry.repo === "openai/codex") ?? null;
const recommendedConfig =
  recommendedConfigEntries
    .map((entry) => entry.data)
    .find((entry) => entry.repo === "openai/codex") ?? null;
const hasPublishedSignals = signals.length > 0;
const groupedSignals = groupSignalsByMonth(signals);
const showGroupLabels = groupedSignals.length > 1;
const clientFilterIds = FILTERS.map((filter) => filter.id);
const tryPathCount = signals.filter((signal) => Boolean(signal.how_to_try)).length;
const sourceLinkedCount = signals.filter((signal) => {
  const refs = signal.source_refs;
  return Boolean(refs.pr_url || refs.items?.length || refs.commit_urls.length);
}).length;
const highImpactCount = signals.filter((signal) => signal.impact === "high").length;

const previewSignal: SignalCardData = {
  id: "preview-shell",
  schema: "signal_entry/v1",
  slug: "preview-shell",
  lane: "github",
  kind: "capability",
  title: "GitHub-first signal cards are ready for the first PR-backed entry",
  published_at: "2026-03-20T00:00:00Z",
  summary:
    "The site scaffold now has the one-page feed shell, filter bar, utility slot, and signal-card anatomy needed for the GitHub lane.",
  why_it_matters:
    "This keeps the MVP focused on one strong page while making the next step obvious: publish real bundle-backed signal entries instead of layering more navigation.",
  confidence: "likely",
  impact: "medium",
  config_flags: [],
  caveats: [],
  how_to_try:
    "Add the first validated signal entry under `site/src/content/signals/` once the PR bundle tooling lands.",
  expected_effect:
    "The homepage feed will render real GitHub signals without another route-level refactor.",
  proof_points: [
    "The homepage already exposes title, published date, impact, confidence, summary, and why-it-matters on card.",
    "The filter bar is constrained to all, github, try-now, and high-impact.",
    "The utility slot is visually present but intentionally subordinate to the feed.",
  ],
  source_refs: {
    repo: "openai/codex",
    commit_urls: ["https://docs.astro.build/en/guides/content-collections/"],
    pr_url: "https://docs.github.com/en/pages/getting-started-with-github-pages/using-custom-workflows-with-github-pages",
  },
  previewLabel: "Scaffold Preview",
};

const filterRuntimeScript = `(function () {
  var validFilters = ${JSON.stringify(clientFilterIds)};
  var defaultFilter = "all";

  function isFilter(value) {
    return validFilters.indexOf(value) !== -1;
  }

  function readFilter() {
    var params = new URLSearchParams(window.location.search);
    var value = params.get("filter");
    return isFilter(value) ? value : defaultFilter;
  }

  function matchCard(card, filter) {
    if (filter === "all") return true;
    if (filter === "github") return card.dataset.filterLane === "github";
    if (filter === "try-now") return card.dataset.filterTry === "true";
    if (filter === "high-impact") return card.dataset.filterImpact === "high";
    return true;
  }

  function updateEmptyState(filter, visibleCount) {
    var empty = document.querySelector("[data-empty-state]");
    if (!empty) return;
    if (visibleCount > 0) {
      empty.hidden = true;
      return;
    }
    var title = empty.querySelector("[data-empty-title]");
    var body = empty.querySelector("[data-empty-body]");
    var payload = empty.getAttribute("data-empty-messages");
    if (payload && title && body) {
      try {
        var messages = JSON.parse(payload);
        var message = messages[filter] || messages.all;
        title.textContent = message.title;
        body.textContent = message.body;
      } catch (_) {}
    }
    empty.hidden = false;
  }

  function updateGroups() {
    document.querySelectorAll("[data-feed-group]").forEach(function (group) {
      var anyVisible = group.querySelector("[data-signal-card]:not([hidden])");
      group.hidden = !anyVisible;
    });
  }

  function syncActiveFilter(filter) {
    document.querySelectorAll("[data-filter-option]").forEach(function (link) {
      var active = link.getAttribute("data-filter-option") === filter;
      link.setAttribute("data-active", active ? "true" : "false");
      if (active) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  }

  function animateRegion() {
    var region = document.querySelector("[data-feed-region]");
    if (!region) return;
    region.classList.remove("feed-region--filtering");
    void region.offsetWidth;
    region.classList.add("feed-region--filtering");
  }

  function applyFilter(filter, options) {
    var opts = options || {};
    var visibleCount = 0;
    document.querySelectorAll("[data-signal-card]").forEach(function (card) {
      var visible = matchCard(card, filter);
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });
    updateGroups();
    updateEmptyState(filter, visibleCount);
    syncActiveFilter(filter);

    if (opts.animate) {
      animateRegion();
    }

    if (opts.updateHistory) {
      var url = new URL(window.location.href);
      if (filter === "all") url.searchParams.delete("filter");
      else url.searchParams.set("filter", filter);
      history.pushState({ filter: filter }, "", url);
    }
  }

  function bind() {
    document.querySelectorAll("[data-filter-option]").forEach(function (link) {
      if (link.dataset.filterBound === "true") return;
      link.dataset.filterBound = "true";
      link.addEventListener("click", function (event) {
        var filter = link.getAttribute("data-filter-option");
        if (!isFilter(filter)) return;
        event.preventDefault();
        applyFilter(filter, { updateHistory: true, animate: true });
      });
    });

    applyFilter(readFilter(), { updateHistory: false, animate: false });
  }

  document.addEventListener("astro:page-load", bind);
  document.addEventListener("DOMContentLoaded", bind);
  window.addEventListener("popstate", function () {
    applyFilter(readFilter(), { updateHistory: false, animate: false });
  });
})();`;

---

<BaseLayout
  title="Decodex"
  description="The signal layer for Codex changes worth tracking."
>
  <main class="site-frame">
    <header class="site-topbar">
      <div class="site-topbar__head">
        <div class="site-head__logo">
          <a class="site-brand__wordmark" href="/" aria-label="Decodex home">
            <img
              class="site-brand__wordmark-image"
              src="/assets/logo.png"
              alt="Decodex"
              width="801"
              height="293"
            />
          </a>
        </div>

        <div class="site-head__utility">
          <div class="site-head__theme">
            <ThemeToggle />
          </div>

          <div class="site-head__cues">
            <ul class="site-brand__cues" aria-label="Decodex promises">
              <li class="site-brand__cue">
                <span class="site-brand__cue-label">Try paths</span>
                <span class="site-brand__cue-value">{tryPathCount}</span>
              </li>
              <li class="site-brand__cue">
                <span class="site-brand__cue-label">Source links</span>
                <span class="site-brand__cue-value">{sourceLinkedCount}/{signals.length}</span>
              </li>
              <li class="site-brand__cue">
                <span class="site-brand__cue-label">High impact</span>
                <span class="site-brand__cue-value">{highImpactCount}</span>
              </li>
            </ul>
          </div>
        </div>

        <p class="site-brand__note">
          Signal layer for Codex. GitHub-first, release-aware, and optimized for what is worth trying next.
        </p>

        <div class="site-head__status">
          <ResetStatusWidget variant="inline" />
        </div>

        <a
          class="site-brand__social"
          href="https://x.com/YvetteCipher"
          target="_blank"
          rel="noreferrer"
          aria-label="Follow YvetteCipher on X"
        >
          <span class="site-brand__social-handle">@YvetteCipher on X</span>
          <span class="site-brand__social-copy">
            Follow to help cover ops and unlock creator rewards.
          </span>
        </a>

        <div class="site-head__actions">
          <AppcastDownloadWidget />
        </div>

      </div>
    </header>

    {releaseDelta ? (
      <ReleaseDeltaPanel delta={releaseDelta} trackedSignals={signals} recommendedConfig={recommendedConfig} />
    ) : null}

    <section class="feed-toolbar" id="latest-signals">
      <div class="feed-toolbar__intro">
        <p class="feed-toolbar__label">Latest signals</p>
      </div>

      <div class="feed-toolbar__controls">
        <FilterBar activeFilter={activeFilter} />
      </div>
    </section>

    <section class="feed-region" data-feed-region>
      {!hasPublishedSignals ? <SignalCard signal={previewSignal} /> : null}
      {hasPublishedSignals ? <EmptyFeedState activeFilter={activeFilter} /> : null}

      {groupedSignals.map((group) => (
        <section class="feed-group" data-feed-group>
          {showGroupLabels ? (
            <div class="feed-group__label">
              <span>{group.label}</span>
            </div>
          ) : null}

          <div class="space-y-4">
            {group.items.map((signal) => <SignalCard signal={signal} />)}
          </div>
        </section>
      ))}
    </section>
  </main>
  {hasPublishedSignals ? <script is:inline set:html={filterRuntimeScript}></script> : null}
</BaseLayout>
