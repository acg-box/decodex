---
import AppcastDownloadWidget from "@/components/AppcastDownloadWidget.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { commands, decodexGitHubUrl, docs, productLoops } from "@/lib/homeContent";
import homeInteractionBindScript from "@/scripts/homeInteractions/bind.js?raw";
import homeInteractionHeroScript from "@/scripts/homeInteractions/hero.js?raw";
import homeInteractionPressScript from "@/scripts/homeInteractions/press.js?raw";
import homeInteractionQueryScript from "@/scripts/homeInteractions/query.js?raw";
import homeInteractionRevealScript from "@/scripts/homeInteractions/reveals.js?raw";
import homeInteractionStateScript from "@/scripts/homeInteractions/state.js?raw";

const interactionRuntimeScript = [
  homeInteractionStateScript,
  homeInteractionQueryScript,
  homeInteractionRevealScript,
  homeInteractionPressScript,
  homeInteractionHeroScript,
  homeInteractionBindScript,
].join("\n");
---

<BaseLayout
  title="Decodex"
  description="A local agent workspace for Codex conversations, account routing, and durable work coordination."
>
  <main class="official-site">
    <section class="official-hero" aria-label="Decodex homepage">
      <header class="site-header">
        <a class="site-logo" href="/" aria-label="Decodex home">
          <img
            class="site-logo__image"
            src="/assets/logo.png"
            alt="Decodex"
            width="801"
            height="293"
          />
        </a>
        <nav class="site-nav" aria-label="Site navigation">
          <a href="#runtime">Runtime</a>
          <a href="#app">App</a>
          <a href="#docs">Docs</a>
        </nav>
        <ThemeToggle />
      </header>

      <div class="hero-grid">
        <div class="hero-copy" data-reveal>
          <h1>Decodex</h1>
          <p>
            A local agent workspace for Codex. Coordinate goals across conversations,
            manage account routing, and keep work, dependencies, and decisions together.
          </p>
          <div class="hero-actions" aria-label="Primary actions">
            <a href={decodexGitHubUrl} target="_blank" rel="noreferrer">GitHub</a>
            <a href="#runtime">Runtime map</a>
            <a href="#docs">Documentation</a>
          </div>
        </div>

        <aside class="hero-panel" aria-label="OpenAI Codex download" data-reveal>
          <div class="hero-panel__copy">
            <span>Related software from OpenAI</span>
            <strong>Codex beta for macOS.</strong>
          </div>
          <AppcastDownloadWidget />
        </aside>
      </div>

      <div class="hero-bottom" aria-label="Decodex product surfaces">
        <div>
          <strong>Agent</strong>
          <span>Coordination</span>
        </div>
        <div>
          <strong>Conversations</strong>
          <span>Codex threads</span>
        </div>
        <div>
          <strong>Accounts</strong>
          <span>Routing</span>
        </div>
        <div>
          <strong>macOS App</strong>
          <span>Workspace</span>
        </div>
      </div>
    </section>

    <section class="site-section runtime-section" id="runtime" data-reveal>
      <div class="section-heading">
        <h2>Runtime Map</h2>
        <p>
          Agent coordinates your goals through independent Codex threads. The local service
          preserves work relationships and decisions across restarts.
        </p>
      </div>
      <div class="system-panel">
        <div class="system-panel__lead">
          <span>Core loop</span>
          <strong>Agent coordinates work. Codex runs the conversations.</strong>
        </div>
        <ol class="system-loop">
          {productLoops.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="site-section app-section" id="app" data-reveal>
      <div class="section-heading">
        <h2>Desktop and CLI</h2>
        <p>
          The Decodex desktop app and CLI use the same local service. Open the source repository
          for build instructions and the current macOS requirements.
        </p>
      </div>
      <div class="command-panel">
        <div class="command-panel__copy">
          <span>Common commands</span>
          <p>Inspect service readiness, Agent work, and accounts, or launch the desktop app from source.</p>
        </div>
        <ul class="command-list" aria-label="Common Decodex commands">
          {commands.map((command) => (
            <li><code>{command}</code></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="site-section docs-section" id="docs" data-reveal>
      <div class="section-heading">
        <h2>Documentation</h2>
        <p>
          Read the current product workflow, service architecture, and validation commands.
        </p>
      </div>
      <div class="docs-grid">
        {docs.map((item) => (
          <a class="doc-link" href={item.href} target="_blank" rel="noreferrer">
            <span>{item.title}</span>
            <strong>Open source</strong>
          </a>
        ))}
      </div>
    </section>
  </main>
  <script is:inline set:html={interactionRuntimeScript}></script>
</BaseLayout>
