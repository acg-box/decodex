---
import AppcastDownloadWidget from "@/components/AppcastDownloadWidget.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { commands, decodexGitHubUrl, docs, productLoops } from "@/lib/homeContent";
import homeInteractionBindScript from "@/scripts/homeInteractions/bind.js?raw";
import homeInteractionHeroScript from "@/scripts/homeInteractions/hero.js?raw";
import homeInteractionPressScript from "@/scripts/homeInteractions/press.js?raw";
import homeInteractionQueryScript from "@/scripts/homeInteractions/query.js?raw";
import homeInteractionRevealScript from "@/scripts/homeInteractions/reveals.js?raw";
import homeInteractionStateScript from "@/scripts/homeInteractions/state.js?raw";

const interactionRuntimeScript = [
  homeInteractionStateScript,
  homeInteractionQueryScript,
  homeInteractionRevealScript,
  homeInteractionPressScript,
  homeInteractionHeroScript,
  homeInteractionBindScript,
].join("\n");
---

<BaseLayout
  title="Decodex"
  description="Repo-native control plane for Codex work, retained lanes, and local operator delivery."
>
  <main class="official-site">
    <section class="official-hero" aria-label="Decodex homepage">
      <header class="site-header">
        <a class="site-logo" href="/" aria-label="Decodex home">
          <img
            class="site-logo__image"
            src="/assets/logo.png"
            alt="Decodex"
            width="801"
            height="293"
          />
        </a>
        <nav class="site-nav" aria-label="Site navigation">
          <a href="#runtime">Runtime</a>
          <a href="#app">App</a>
          <a href="#docs">Docs</a>
        </nav>
        <ThemeToggle />
      </header>

      <div class="hero-grid">
        <div class="hero-copy" data-reveal>
          <h1>Decodex</h1>
          <p>
            Repo-native control software for Codex lanes: project registration, retained
            execution, operator status, account pools, review handoff, and delivery policy.
          </p>
          <div class="hero-actions" aria-label="Primary actions">
            <a href={decodexGitHubUrl} target="_blank" rel="noreferrer">GitHub</a>
            <a href="#runtime">Runtime map</a>
            <a href="#docs">Documentation</a>
          </div>
        </div>

        <aside class="hero-panel" aria-label="Decodex application" data-reveal>
          <div class="hero-panel__logo">
            <img src="/assets/icon.png" alt="" width="256" height="256" />
          </div>
          <div class="hero-panel__copy">
            <span>Native companion</span>
            <strong>Local account-pool management for Codex runs.</strong>
          </div>
          <AppcastDownloadWidget />
        </aside>
      </div>

      <div class="hero-bottom" aria-label="Decodex product surfaces">
        <div>
          <strong>Rust CLI</strong>
          <span>Runtime</span>
        </div>
        <div>
          <strong>macOS App</strong>
          <span>Accounts</span>
        </div>
        <div>
          <strong>Local HTTP</strong>
          <span>Operator</span>
        </div>
        <div>
          <strong>Programs</strong>
          <span>Domain Packs</span>
        </div>
      </div>
    </section>

    <section class="site-section runtime-section" id="runtime" data-reveal>
      <div class="section-heading">
        <h2>Runtime Map</h2>
        <p>
          Decodex keeps repository authority explicit while the local control plane
          coordinates long-running coding work.
        </p>
      </div>
      <div class="system-panel">
        <div class="system-panel__lead">
          <span>Core loop</span>
          <strong>One local runtime owns scheduling, evidence, recovery, and delivery state.</strong>
        </div>
        <ol class="system-loop">
          {productLoops.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="site-section app-section" id="app" data-reveal>
      <div class="section-heading">
        <h2>Operator Tools</h2>
        <p>
          The CLI, local operator listener, and native app all talk to local Decodex state instead
          of a hosted backend.
        </p>
      </div>
      <div class="command-panel">
        <div class="command-panel__copy">
          <span>Common commands</span>
          <p>Start the local control plane, inspect live state, and hand evidence to repair agents.</p>
        </div>
        <ul class="command-list" aria-label="Common Decodex commands">
          {commands.map((command) => (
            <li><code>{command}</code></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="site-section docs-section" id="docs" data-reveal>
      <div class="section-heading">
        <h2>Documentation</h2>
        <p>
          Runtime truth lives in checked-in specs, project contracts, and source-owned
          validation.
        </p>
      </div>
      <div class="docs-grid">
        {docs.map((item) => (
          <a class="doc-link" href={item.href} target="_blank" rel="noreferrer">
            <span>{item.title}</span>
            <strong>Open source</strong>
          </a>
        ))}
      </div>
    </section>
  </main>
  <script is:inline set:html={interactionRuntimeScript}></script>
</BaseLayout>
