---
import "@/styles/global.css";
import themeInitScript from "@/scripts/theme/init.js?raw";
import themeToggleScript from "@/scripts/theme/toggle.js?raw";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Decodex",
  description = "Repo-native control plane for Codex work and retained lanes.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fc" />
    <link rel="icon" type="image/png" href="/assets/icon.png" />
    <link rel="icon" href="/assets/logo.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/logo-touch.png" />
    <title>{title}</title>
    <script is:inline set:html={themeInitScript}></script>
  </head>
  <body>
    <div class="site-shell">
      <slot />
    </div>
    <script is:inline set:html={themeToggleScript}></script>
  </body>
</html>
