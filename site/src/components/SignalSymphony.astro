---
type Props = {
  totalSignals: number;
  tryPathCount: number;
  highImpactCount: number;
};

const { totalSignals, tryPathCount, highImpactCount } = Astro.props;
---

<div
  class="symphony-scene"
  aria-hidden="true"
  data-symphony-scene
  data-total-signals={totalSignals}
  data-try-paths={tryPathCount}
  data-high-impact={highImpactCount}
></div>

<script>
  import type * as ThreeTypes from "three";

  type SymphonyRoot = HTMLElement & {
    __decodexSymphonyCleanup?: () => void;
  };
  type Disposable = {
    dispose: () => void;
  };
  type ThreeModule = typeof import("three");
  type SceneObject = ThreeTypes.Object3D & {
    geometry?: ThreeTypes.BufferGeometry;
    material?: ThreeTypes.Material | ThreeTypes.Material[];
  };

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let threePromise: Promise<ThreeModule> | null = null;

  function loadThree() {
    threePromise ??= import("three");
    return threePromise;
  }

  function disposeMaterial(material: ThreeTypes.Material | ThreeTypes.Material[]) {
    if (Array.isArray(material)) {
      material.forEach(disposeMaterial);
      return;
    }
    material.dispose();
  }

  async function initSymphonyScene(rootCandidate: Element) {
    if (!(rootCandidate instanceof HTMLElement)) return;
    const THREE = await loadThree();
    const root = rootCandidate as SymphonyRoot;
    if (typeof root.__decodexSymphonyCleanup === "function") {
      root.__decodexSymphonyCleanup();
    }

    const totalSignals = Number(root.dataset.totalSignals ?? 0);
    const tryPaths = Number(root.dataset.tryPaths ?? 0);
    const highImpact = Number(root.dataset.highImpact ?? 0);
    const rect = root.getBoundingClientRect();
    const width = Math.max(320, rect.width || 960);
    const height = Math.max(420, rect.height || 680);
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 120);
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    const constellation = new THREE.Group();
    const pulse = new THREE.Group();
    const startMs = performance.now();
    const disposables: Disposable[] = [];
    let frameId = 0;
    let pointerX = 0;
    let pointerY = 0;

    camera.position.set(0, 0.35, 9.4);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height);
    root.innerHTML = "";
    root.appendChild(renderer.domElement);
    scene.add(constellation);
    scene.add(pulse);

    const lightLinePoints = [
      new THREE.Vector3(-4.8, 1.35, -0.5),
      new THREE.Vector3(-1.8, -1.15, 0.25),
      new THREE.Vector3(0.65, 1.25, -0.12),
      new THREE.Vector3(3.95, -0.72, 0.45),
    ];
    const pipelineGeometry = new THREE.BufferGeometry().setFromPoints(lightLinePoints);
    const pipelineMaterial = new THREE.LineBasicMaterial({
      color: 0x8ab4ff,
      transparent: true,
      opacity: 0.4,
    });
    const pipeline = new THREE.Line(pipelineGeometry, pipelineMaterial);
    constellation.add(pipeline);
    disposables.push(pipelineGeometry, pipelineMaterial);

    const nodeGeometry = new THREE.IcosahedronGeometry(1, 2);
    const nodeColors = [0xb6f13a, 0x7fb0ff, 0xffffff, 0xff5db7];
    const nodeSizes = [
      0.38 + Math.min(totalSignals, 80) * 0.002,
      0.32 + Math.min(tryPaths, 60) * 0.003,
      0.46,
      0.3 + Math.min(highImpact, 24) * 0.007,
    ];
    disposables.push(nodeGeometry);
    lightLinePoints.forEach((position, index) => {
      const material = new THREE.MeshBasicMaterial({
        color: nodeColors[index],
        wireframe: true,
        transparent: true,
        opacity: index === 2 ? 0.72 : 0.78,
      });
      const mesh = new THREE.Mesh(nodeGeometry, material);
      mesh.position.copy(position);
      mesh.scale.setScalar(nodeSizes[index]);
      constellation.add(mesh);
      disposables.push(material);
    });

    const ringGeometry = new THREE.TorusGeometry(2.45, 0.015, 10, 160);
    const ringMaterial = new THREE.MeshBasicMaterial({
      color: 0xb6f13a,
      transparent: true,
      opacity: 0.48,
    });
    const ring = new THREE.Mesh(ringGeometry, ringMaterial);
    ring.position.set(0.45, 0.05, -0.4);
    ring.rotation.x = Math.PI * 0.58;
    pulse.add(ring);
    disposables.push(ringGeometry, ringMaterial);

    const secondaryRingGeometry = new THREE.TorusGeometry(3.25, 0.009, 8, 180);
    const secondaryRingMaterial = new THREE.MeshBasicMaterial({
      color: 0xff5db7,
      transparent: true,
      opacity: 0.22,
    });
    const secondaryRing = new THREE.Mesh(secondaryRingGeometry, secondaryRingMaterial);
    secondaryRing.position.set(0.45, 0.05, -0.7);
    secondaryRing.rotation.x = Math.PI * 0.58;
    secondaryRing.rotation.z = 0.4;
    pulse.add(secondaryRing);
    disposables.push(secondaryRingGeometry, secondaryRingMaterial);

    const particleCount = 260;
    const positions = new Float32Array(particleCount * 3);
    const colors = new Float32Array(particleCount * 3);
    const colorA = new THREE.Color(0xb6f13a);
    const colorB = new THREE.Color(0x8ab4ff);
    const colorC = new THREE.Color(0xff5db7);
    for (let index = 0; index < particleCount; index += 1) {
      const angle = index * 0.41;
      const radius = 1.2 + (index % 47) * 0.065;
      const lane = (index % 9) - 4;
      positions[index * 3] = Math.cos(angle) * radius + lane * 0.12;
      positions[index * 3 + 1] = Math.sin(angle * 0.72) * radius * 0.38;
      positions[index * 3 + 2] = ((index % 61) - 30) * 0.05;
      const color = index % 7 === 0 ? colorC : index % 2 === 0 ? colorA : colorB;
      colors[index * 3] = color.r;
      colors[index * 3 + 1] = color.g;
      colors[index * 3 + 2] = color.b;
    }

    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
    particleGeometry.setAttribute("color", new THREE.BufferAttribute(colors, 3));
    const particleMaterial = new THREE.PointsMaterial({
      size: 0.04,
      vertexColors: true,
      transparent: true,
      opacity: 0.82,
      depthWrite: false,
    });
    const particles = new THREE.Points(particleGeometry, particleMaterial);
    pulse.add(particles);
    disposables.push(particleGeometry, particleMaterial);

    function resize() {
      const nextRect = root.getBoundingClientRect();
      const nextWidth = Math.max(320, nextRect.width || width);
      const nextHeight = Math.max(420, nextRect.height || height);
      camera.aspect = nextWidth / nextHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(nextWidth, nextHeight);
    }

    function render() {
      const elapsed = (performance.now() - startMs) / 1000;
      constellation.rotation.y = elapsed * 0.14 + pointerX * 0.18;
      constellation.rotation.x = -0.08 + pointerY * 0.09;
      pulse.rotation.y = elapsed * 0.1;
      ring.rotation.z = elapsed * 0.32;
      secondaryRing.rotation.z = -elapsed * 0.22;
      particles.rotation.z = -elapsed * 0.07;
      particles.rotation.y = elapsed * 0.1;
      renderer.render(scene, camera);
      if (!prefersReducedMotion.matches) {
        frameId = window.requestAnimationFrame(render);
      }
    }

    const observer = new ResizeObserver(resize);
    observer.observe(root);

    function onPointerMove(event: PointerEvent) {
      const bounds = root.getBoundingClientRect();
      pointerX = ((event.clientX - bounds.left) / bounds.width - 0.5) * 2;
      pointerY = ((event.clientY - bounds.top) / bounds.height - 0.5) * 2;
    }

    root.addEventListener("pointermove", onPointerMove);
    render();

    root.__decodexSymphonyCleanup = () => {
      window.cancelAnimationFrame(frameId);
      observer.disconnect();
      root.removeEventListener("pointermove", onPointerMove);
      disposables.forEach((item) => item.dispose());
      scene.traverse((object: ThreeTypes.Object3D) => {
        const sceneObject = object as SceneObject;
        if (sceneObject.material) disposeMaterial(sceneObject.material);
        if (sceneObject.geometry) sceneObject.geometry.dispose();
      });
      renderer.dispose();
      renderer.domElement.remove();
      root.__decodexSymphonyCleanup = undefined;
    };
  }

  function bindSymphonyScenes() {
    document.querySelectorAll("[data-symphony-scene]").forEach((root) => {
      void initSymphonyScene(root);
    });
  }

  document.addEventListener("astro:page-load", bindSymphonyScenes);
  document.addEventListener("DOMContentLoaded", bindSymphonyScenes);
  bindSymphonyScenes();
</script>
