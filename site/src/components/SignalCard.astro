---
import {
  confidenceLabel,
  formatPublishedAt,
  impactLabel,
  kindLabel,
  type SourceRefItem,
  type SignalCardData,
} from "@/lib/signal-feed";
import { resolveConfigFlags } from "@/lib/config-flags";
import { renderMarkdownInline } from "@/lib/render-markdown";

type Props = {
  signal: SignalCardData;
};

const { signal } = Astro.props;
const renderedTitle = renderMarkdownInline(signal.title);
const renderedSummary = renderMarkdownInline(signal.summary);
const renderedWhyItMatters = renderMarkdownInline(signal.why_it_matters);
const renderedHowToTry = signal.how_to_try
  ? renderMarkdownInline(signal.how_to_try)
  : null;
const renderedExpectedEffect = signal.expected_effect
  ? renderMarkdownInline(signal.expected_effect)
  : null;
const renderedWatchState = signal.watch_state
  ? renderMarkdownInline(signal.watch_state)
  : null;
const resolvedFlags = resolveConfigFlags(signal.config_flags);
const configToggleFlags = resolvedFlags.filter((flag) => flag.kind === "feature");
const visibleFlags = resolvedFlags.filter((flag) => flag.kind === "raw");
const sourceItems: SourceRefItem[] =
  signal.source_refs.items && signal.source_refs.items.length > 0
    ? signal.source_refs.items
    : [
        ...(signal.source_refs.pr_url
          ? [{ kind: "pull_request" as const, title: "Open pull request", url: signal.source_refs.pr_url }]
          : []),
        ...signal.source_refs.commit_urls.map((url, index) => ({
          kind: "commit" as const,
          title: `Open commit ${index + 1}`,
          url,
        })),
      ];
---

<article
  class="signal-card"
  id={signal.slug}
  data-signal-card
  data-filter-lane={signal.lane}
  data-filter-try={signal.kind === "try_now" || Boolean(signal.how_to_try) ? "true" : "false"}
  data-filter-impact={signal.impact}
>
  <aside class="signal-entry__rail">
    <span class="signal-entry-date">
      {formatPublishedAt(signal.published_at)}
    </span>

    <div class="signal-entry__taxonomy">
      <span class="signal-entry__taxonomy-item signal-entry__taxonomy-item--accent">
        {kindLabel(signal.kind)}
      </span>
      <span class="signal-entry__taxonomy-item">{impactLabel(signal.impact)}</span>
      <span class="signal-entry__taxonomy-item">{confidenceLabel(signal.confidence)}</span>
    </div>
  </aside>

  <div class="signal-entry__content">
    <div class="space-y-3">
      {signal.previewLabel ? (
        <p class="signal-entry__preview">
          {signal.previewLabel}
        </p>
      ) : null}

      <h2
        class="signal-markdown signal-markdown--title signal-entry__title"
        set:html={renderedTitle}
      />

      <p
        class="signal-markdown signal-entry__summary"
        set:html={renderedSummary}
      />

      <p class="signal-entry__why">
        <span class="signal-entry-label">Why it matters</span>
        <span class="signal-markdown signal-markdown--inline" set:html={renderedWhyItMatters} />
      </p>
    </div>

    <section class="signal-entry-action">
      <p class="signal-entry-action__row">
        <span class="signal-entry-label">Action</span>
        <span class="signal-entry-action__body">
          {renderedHowToTry ? (
            <>
              <span class="terminal-inline">Try now</span>{" "}
              <span class="signal-markdown signal-markdown--inline" set:html={renderedHowToTry} />
            </>
          ) : (
            "Watch only. No safe try path is published for this signal yet."
          )}
        </span>
      </p>

      {signal.expected_effect ? (
        <p class="signal-entry-action__effect">
          <span class="signal-entry-label">Expected effect</span>
          <span class="signal-markdown signal-markdown--inline" set:html={renderedExpectedEffect ?? ""} />
        </p>
      ) : null}

      {configToggleFlags.length > 0 ? (
        <div class="signal-entry-config">
          <p class="signal-entry-label">Config</p>
          <p class="signal-entry-config__hint">
            Add to <code>$CODEX_HOME/config.toml</code>.
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            {configToggleFlags.map((flag) => (
              <code class="signal-flag" title={flag.cliEnableFlag ?? flag.raw}>
                {flag.display}
              </code>
            ))}
          </div>
        </div>
      ) : null}

      {visibleFlags.length > 0 ? (
        <div class="mt-3 flex flex-wrap gap-2">
          {visibleFlags.map((flag) => (
            <code class="signal-flag">
              {flag.display}
            </code>
          ))}
        </div>
      ) : null}
    </section>

    <details class="signal-entry-details">
      <summary class="signal-entry-details__summary">
        <span>Sources and evidence</span>
        <span>{signal.proof_points.length} proof point{signal.proof_points.length === 1 ? "" : "s"}</span>
      </summary>

      <div class="signal-entry-details__body">
        <ul class="space-y-2 text-[0.88rem] leading-6 text-[color:var(--ink-soft)]">
          {signal.proof_points.map((point) => (
            <li class="signal-proof-item">
              <span class="signal-markdown signal-markdown--inline" set:html={renderMarkdownInline(point)} />
            </li>
          ))}
        </ul>

        {signal.caveats.length > 0 ? (
          <div class="mt-5">
            <p class="signal-entry-label">Caveats</p>
            <ul class="mt-2 space-y-2 text-[0.88rem] leading-6 text-[color:var(--ink-soft)]">
              {signal.caveats.map((caveat) => (
                <li class="signal-proof-item">
                  <span class="signal-markdown signal-markdown--inline" set:html={renderMarkdownInline(caveat)} />
                </li>
              ))}
            </ul>
          </div>
        ) : null}

        {renderedWatchState ? (
          <p class="mt-5 text-[0.88rem] leading-6 text-[color:var(--ink-soft)]">
            <span class="signal-entry-label">Watch state</span>{" "}
            <span class="signal-markdown signal-markdown--inline" set:html={renderedWatchState} />
          </p>
        ) : null}

        <ol class="signal-source-timeline">
          {sourceItems.map((source) => (
            <li class="signal-source-timeline__item">
              <span class={`signal-source-timeline__kind signal-source-timeline__kind--${source.kind}`}>
                {source.kind === "pull_request" ? "PR" : "Commit"}
              </span>
              <a class="signal-source-timeline__title signal-link" href={source.url} target="_blank" rel="noreferrer">
                {source.title}
              </a>
              {source.meta ? <span class="signal-source-timeline__meta">{source.meta}</span> : null}
            </li>
          ))}
        </ol>
      </div>
    </details>
  </div>
</article>
