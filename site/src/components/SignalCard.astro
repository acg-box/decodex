---
import {
  confidenceLabel,
  formatPublishedAt,
  impactLabel,
  kindLabel,
  type SourceRefItem,
  type SignalCardData,
} from "@/lib/signal-feed";
import { resolveConfigFlags } from "@/lib/config-flags";
import { renderMarkdownInline } from "@/lib/render-markdown";

type Props = {
  signal: SignalCardData;
};

const { signal } = Astro.props;
const renderedTitle = renderMarkdownInline(signal.title);
const renderedSummary = renderMarkdownInline(signal.summary);
const renderedWhyItMatters = renderMarkdownInline(signal.why_it_matters);
const renderedHowToTry = signal.how_to_try
  ? renderMarkdownInline(signal.how_to_try)
  : null;
const renderedExpectedEffect = signal.expected_effect
  ? renderMarkdownInline(signal.expected_effect)
  : null;
const renderedWatchState = signal.watch_state
  ? renderMarkdownInline(signal.watch_state)
  : null;
const resolvedFlags = resolveConfigFlags(signal.config_flags);
const configToggleFlags = resolvedFlags.filter((flag) => flag.kind === "feature");
const visibleFlags = resolvedFlags.filter((flag) => flag.kind === "raw");
const sourceItems: SourceRefItem[] =
  signal.source_refs.items && signal.source_refs.items.length > 0
    ? signal.source_refs.items
    : [
        ...(signal.source_refs.pr_url
          ? [{ kind: "pull_request" as const, title: "Open pull request", url: signal.source_refs.pr_url }]
          : []),
        ...signal.source_refs.commit_urls.map((url, index) => ({
          kind: "commit" as const,
          title: `Open commit ${index + 1}`,
          url,
        })),
      ];
const primarySource = sourceItems.find((source) => source.kind === "pull_request") ?? sourceItems[0];
---

<article
  class="signal-card"
  id={signal.slug}
  data-signal-card
  data-filter-lane={signal.lane}
  data-filter-try={signal.kind === "try_now" || Boolean(signal.how_to_try) ? "true" : "false"}
  data-filter-impact={signal.impact}
>
  <div class="signal-card__index">
    <time datetime={signal.published_at}>{formatPublishedAt(signal.published_at)}</time>
    {primarySource ? (
      <a href={primarySource.url} target="_blank" rel="noreferrer">
        {primarySource.meta ?? primarySource.title}
      </a>
    ) : null}
  </div>

  <div class="signal-card__body">
    <header class="signal-card__header">
      {signal.previewLabel ? <p class="signal-card__preview">{signal.previewLabel}</p> : null}
      <div class="signal-card__taxonomy" aria-label="Signal classification">
        <span>{kindLabel(signal.kind)}</span>
        <span>{impactLabel(signal.impact)}</span>
        <span>{confidenceLabel(signal.confidence)}</span>
      </div>
      <h2 class="signal-markdown signal-markdown--title" set:html={renderedTitle} />
      <p class="signal-markdown signal-card__summary" set:html={renderedSummary} />
    </header>

    <div class="signal-card__readout">
      <section>
        <h3>Why it matters</h3>
        <p class="signal-markdown signal-markdown--inline" set:html={renderedWhyItMatters} />
      </section>
      <section>
        <h3>{renderedHowToTry ? "Try path" : "Watch state"}</h3>
        {
          renderedHowToTry ? (
            <p class="signal-markdown signal-markdown--inline" set:html={renderedHowToTry} />
          ) : renderedWatchState ? (
            <p class="signal-markdown signal-markdown--inline" set:html={renderedWatchState} />
          ) : (
            <p>Watch only. No safe try path is published for this signal yet.</p>
          )
        }
      </section>
    </div>

    {signal.expected_effect ? (
      <p class="signal-card__effect">
        <span>Expected effect</span>
        <span class="signal-markdown signal-markdown--inline" set:html={renderedExpectedEffect ?? ""} />
      </p>
    ) : null}

    {configToggleFlags.length > 0 || visibleFlags.length > 0 ? (
      <div class="signal-card__flags" aria-label="Config flags">
        {configToggleFlags.length > 0 ? <span>Add to <code>$CODEX_HOME/config.toml</code></span> : null}
        {configToggleFlags.map((flag) => (
          <code class="signal-flag" title={flag.cliEnableFlag ?? flag.raw}>
            {flag.display}
          </code>
        ))}
        {visibleFlags.map((flag) => (
          <code class="signal-flag">
            {flag.display}
          </code>
        ))}
      </div>
    ) : null}

    <details class="signal-card__evidence">
      <summary>
        <span>Evidence</span>
        <span>{signal.proof_points.length} proof point{signal.proof_points.length === 1 ? "" : "s"}</span>
      </summary>

      <div class="signal-card__evidence-body">
        <ul class="signal-proof-list">
          {signal.proof_points.map((point) => (
            <li class="signal-proof-item">
              <span class="signal-markdown signal-markdown--inline" set:html={renderMarkdownInline(point)} />
            </li>
          ))}
        </ul>

        {signal.caveats.length > 0 ? (
          <div class="signal-card__caveats">
            <h3>Caveats</h3>
            <ul class="signal-proof-list">
              {signal.caveats.map((caveat) => (
                <li class="signal-proof-item">
                  <span class="signal-markdown signal-markdown--inline" set:html={renderMarkdownInline(caveat)} />
                </li>
              ))}
            </ul>
          </div>
        ) : null}

        {renderedWatchState && renderedHowToTry ? (
          <p class="signal-card__watch">
            <span>Watch state</span>
            <span class="signal-markdown signal-markdown--inline" set:html={renderedWatchState} />
          </p>
        ) : null}

        <ol class="signal-source-list">
          {sourceItems.map((source) => (
            <li>
              <span>{source.kind === "pull_request" ? "PR" : "Commit"}</span>
              <a href={source.url} target="_blank" rel="noreferrer">
                {source.title}
              </a>
              {source.meta ? <small>{source.meta}</small> : null}
            </li>
          ))}
        </ol>
      </div>
    </details>
  </div>
</article>
