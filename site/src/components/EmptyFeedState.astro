---
import type { FilterId } from "@/lib/signal-feed";

type Props = {
  activeFilter: FilterId;
};

const { activeFilter } = Astro.props;

const messages: Record<FilterId, { title: string; body: string }> = {
  all: {
    title: "No GitHub signals have been published yet.",
    body: "The feed shell is live, but no validated signal entries have landed in the collection.",
  },
  github: {
    title: "No GitHub signals match this view yet.",
    body: "The current collection is empty or still waiting for the first rendered GitHub-backed signal.",
  },
  "try-now": {
    title: "No try paths match yet.",
    body: "This filter only shows signals with a concrete user test path.",
  },
  "high-impact": {
    title: "No high impact signals yet.",
    body: "High impact is reserved for the smaller set of changes that clearly alter how users should think about Codex.",
  },
};

const message = messages[activeFilter];
const messagesJson = JSON.stringify(messages);
---

<section
  class="empty-feed-state"
  data-empty-state
  data-empty-messages={messagesJson}
  hidden={activeFilter === "all"}
>
  <p>Empty feed</p>
  <h2 data-empty-title>{message.title}</h2>
  <p data-empty-body>{message.body}</p>
</section>
