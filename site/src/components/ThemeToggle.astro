<div class="theme-toggle" role="group" aria-label="Theme">
  <button class="theme-toggle__button" type="button" data-theme-option="system">
    Auto
  </button>
  <button class="theme-toggle__button" type="button" data-theme-option="light">
    Light
  </button>
  <button class="theme-toggle__button" type="button" data-theme-option="dark">
    Dark
  </button>
</div>
