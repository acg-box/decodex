---
import { FILTERS, type FilterId } from "@/lib/signal-feed";

type Props = {
  activeFilter: FilterId;
};

const { activeFilter } = Astro.props;
---

<nav class="filter-bar" aria-label="Signal filters">
  {
    FILTERS.map((filter) => {
      const isActive = filter.id === activeFilter;

      return (
        <a
          href={filter.id === "all" ? "/" : `/?filter=${filter.id}`}
          class="filter-chip"
          data-filter-option={filter.id}
          data-active={isActive ? "true" : "false"}
          aria-current={isActive ? "page" : undefined}
          title={filter.description}
        >
          {filter.label}
        </a>
      );
    })
  }
</nav>
