---
import { FILTERS, type FilterId } from "@/lib/signal-feed";

type Props = {
  activeFilter: FilterId;
};

const { activeFilter } = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
  {
    FILTERS.map((filter) => {
      const isActive = filter.id === activeFilter;

      return (
        <a
          href={filter.id === "all" ? "/" : `/?filter=${filter.id}`}
          class:list={[
            "border-b-2 px-0 pb-2 text-[0.68rem] font-semibold uppercase tracking-[0.14em] transition",
            isActive
              ? "border-[color:var(--ink)] text-[color:var(--ink)]"
              : "border-transparent text-[color:var(--muted)] hover:border-[color:var(--border-strong)] hover:text-[color:var(--ink)]",
          ]}
          aria-current={isActive ? "page" : undefined}
          title={filter.description}
        >
          {filter.label}
        </a>
      );
    })
  }
</div>
