---
import appcastDownloadScript from "@/scripts/appcastDownload.js?raw";

const appcastUrl = "https://persistent.oaistatic.com/codex-app-beta/appcast.xml";
const appName = "Codex (Beta).app";
const appDownloadLabel = "Download Codex beta";
---

<div class="appcast-download" data-appcast-root data-appcast-url={appcastUrl} data-app-name={appName}>
  <div class="appcast-download__surface" data-appcast-hoverzone>
    <a
      class="appcast-download__primary"
      href={appcastUrl}
      target="_blank"
      rel="noreferrer"
      aria-label={`Download ${appName}`}
      aria-haspopup="menu"
      aria-expanded="false"
      data-appcast-primary
    >
      <span class="appcast-download__body">
        <span class="appcast-download__meta-row">
          <span class="appcast-download__kicker">Latest Codex app</span>
          <span class="appcast-download__meta" data-appcast-primary-meta>Checking latest build</span>
        </span>
        <span class="appcast-download__title">{appDownloadLabel}</span>
      </span>
    </a>

    <div class="appcast-download__panel" role="menu" aria-label="Other Codex (Beta).app versions" data-appcast-panel>
      <p class="appcast-download__panel-label">Versions</p>
      <ul class="appcast-download__list" data-appcast-list>
        <li class="appcast-download__empty">Loading versions...</li>
      </ul>
    </div>
  </div>
</div>

<script is:inline set:html={appcastDownloadScript}></script>
