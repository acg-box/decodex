---
type Props = {
  tryCount: number;
  behaviorCount: number;
  latestLabel: string;
};

const { tryCount, behaviorCount, latestLabel } = Astro.props;
const title =
  tryCount > 0
    ? `${tryCount} signal${tryCount === 1 ? "" : "s"} worth trying now`
    : "Waiting for the first signal";
const meta =
  tryCount > 0
    ? `${behaviorCount} behavior shift${behaviorCount === 1 ? "" : "s"} tracked · Latest ${latestLabel}`
    : "No try-now path published yet";
---

<div class="signal-summary">
  <span class="signal-summary__title">{title}</span>
  <span class="signal-summary__meta">{meta}</span>
</div>
