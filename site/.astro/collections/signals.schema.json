{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "signal_entry/v1"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "const": "github"
    },
    "kind": {
      "type": "string",
      "enum": [
        "capability",
        "behavior_change",
        "try_now"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "confirmed",
        "likely",
        "weak"
      ]
    },
    "impact": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "config_flags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "how_to_try": {
      "type": "string",
      "minLength": 1
    },
    "expected_effect": {
      "type": "string",
      "minLength": 1
    },
    "proof_points": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "pr_url": {
          "type": "string",
          "pattern": "^https:\\/\\/"
        },
        "commit_urls": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https:\\/\\/"
          }
        }
      },
      "required": [
        "repo"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "slug",
    "lane",
    "kind",
    "title",
    "published_at",
    "summary",
    "why_it_matters",
    "confidence",
    "impact",
    "proof_points",
    "source_refs"
  ]
}