{
  "manifest_version": 3,
  "name": "Decodex Research",
  "version": "0.1.0",
  "description": "Connect Decodex to its own ChatGPT research tabs in your existing browser.",
  "minimum_chrome_version": "118",
  "key": "",
  "permissions": ["debugger", "nativeMessaging", "storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Connect Decodex Research"}
}
