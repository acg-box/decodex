{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "disposition": {
      "enum": [
        "staged",
        "accept",
        "request_repair",
        "no_change",
        "rejected"
      ],
      "type": "string"
    },
    "finding_codes": {
      "items": {
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "patch": {
      "maxLength": 4194304,
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "enum": [
        "maintainer",
        "reviewer"
      ],
      "type": "string"
    },
    "schema": {
      "const": "decodex/codex-upstream-agent-result/2",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "role",
    "disposition",
    "finding_codes",
    "patch"
  ],
  "type": "object"
}
