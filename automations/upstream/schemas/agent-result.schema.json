{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "role": {
      "enum": [
        "maintainer",
        "reviewer"
      ],
      "type": "string"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "staged",
            "accept",
            "request_repair",
            "no_change",
            "rejected"
          ],
          "type": "string"
        },
        "finding_codes": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "patch": {
          "maxLength": 4194304,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "disposition",
        "finding_codes",
        "patch"
      ],
      "type": "object"
    },
    "schema": {
      "const": "decodex/codex-upstream-agent-wire-result/1",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "role",
    "result"
  ],
  "type": "object"
}
