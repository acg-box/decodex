{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decodex social publish reservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slug",
    "channel",
    "target_account",
    "mode",
    "status",
    "idempotency_key",
    "publication_lineage_sha256",
    "reserved_at",
    "expires_at",
    "day",
    "timezone",
    "candidate_refs",
    "duplicate_keys",
    "owner"
  ],
  "properties": {
    "schema": {
      "const": "social_publish_reservation/v1"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "const": "x"
    },
    "target_account": {
      "const": "decodexspace"
    },
    "mode": {
      "type": "string",
      "enum": [
        "release_pulse",
        "release_rollup",
        "practical_explainer",
        "operator_impact",
        "watch_note"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["active", "canceled", "consumed", "expired"]
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^content-publication:[0-9a-f]{64}$"
    },
    "publication_lineage_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reserved_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "candidate_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["social_candidates"],
      "properties": {
        "social_candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "duplicate_keys": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_id", "run_id"],
      "properties": {
        "automation_id": {
          "const": "decodex-xurl-publisher"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        }
      }
    },
    "evidence_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "consumed_by_social_post": {
      "type": "string",
      "minLength": 1
    },
    "release_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["consumed_by_social_post"]},
            {"required": ["release_reason"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "consumed"
          }
        }
      },
      "then": {
        "required": ["consumed_by_social_post"],
        "not": {
          "required": ["release_reason"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["canceled", "expired"]
          }
        }
      },
      "then": {
        "required": ["release_reason"],
        "not": {
          "required": ["consumed_by_social_post"]
        }
      }
    }
  ]
}
