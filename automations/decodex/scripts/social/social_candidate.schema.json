{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decodex social candidate record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slug",
    "repo",
    "channel",
    "target_account",
    "mode",
    "priority",
    "audience",
    "candidate_text",
    "source_refs",
    "evidence_notes",
    "claims",
    "decision"
  ],
  "properties": {
    "schema": {
      "const": "social_candidate/v1"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "channel": {
      "const": "x"
    },
    "target_account": {
      "const": "decodexspace"
    },
    "mode": {
      "type": "string",
      "enum": [
        "release_pulse",
        "release_rollup",
        "practical_explainer",
        "operator_impact",
        "watch_note"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "normal", "low"]
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "candidate_text": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "Runtime validation also requires at most 260 conservative twitter-text v3 weighted characters.",
        "minLength": 1,
        "maxLength": 260,
        "allOf": [
          {
            "not": {
              "pattern": "Automated by @hackink"
            }
          },
          {
            "not": {
              "pattern": "^\\s*([Ww][Aa][Tt][Cc][Hh][Ii][Nn][Gg] [Tt][Hh][Ii][Ss]\\.?|[Tt][Rr][Aa][Cc][Kk][Ii][Nn][Gg] [Tt][Hh][Ii][Ss]\\.|.*[Nn][Ee][Ww] [Rr][Ee][Ll][Ee][Aa][Ss][Ee] [Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee].*)"
            }
          },
          {
            "not": {
              "pattern": "(https?://|www\\.)"
              }
          }
        ]
      }
    },
    "text_segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "claim_index"],
            "properties": {
              "kind": {
                "const": "claim"
              },
              "claim_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "text"],
            "properties": {
              "kind": {
                "const": "connective"
              },
              "text": {
                "type": "string",
                "enum": [
                  " "
                ]
              }
            }
          }
        ]
      }
    },
    "radar_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repo",
        "subject_kind",
        "subject_id",
        "slug",
        "upstream_head",
        "commit_shas",
        "queue_sha256",
        "review_sha256",
        "impact_sha256",
        "lineage_sha256"
      ],
      "properties": {
        "schema": {
          "const": "radar_content_eligibility/v1"
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "subject_kind": {
          "type": "string",
          "enum": ["commit", "pr"]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "upstream_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "commit_shas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          }
        },
        "queue_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "impact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lineage_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "radar_source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue", "review", "impact"],
      "properties": {
        "queue": {
          "type": "string",
          "const": ".agent/automations/radar/cache/github/review-queue/openai-codex-latest.json"
        },
        "review": {
          "type": "string",
          "pattern": "^\\.agent/automations/radar/cache/github/content-review-pairs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}--[0-9a-f]{64}--[0-9a-f]{64}/review\\.json$"
        },
        "impact": {
          "type": "string",
          "pattern": "^\\.agent/automations/radar/cache/github/content-review-pairs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}--[0-9a-f]{64}--[0-9a-f]{64}/impact\\.json$"
        }
      }
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["upstream_reviews"]
        },
        {
          "required": ["upstream_impacts"]
        },
        {
          "required": ["signals"]
        },
        {
          "required": ["release_deltas"]
        },
        {
          "required": ["urls"]
        }
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": ["upstream_reviews"]
              },
              {
                "required": ["release_deltas"]
              }
            ]
          },
          "then": {
            "required": ["upstream_impacts"]
          }
        }
      ],
      "properties": {
        "upstream_reviews": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.agent/automations/radar/cache/github/content-review-pairs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}--[0-9a-f]{64}--[0-9a-f]{64}/review\\.json$"
          }
        },
        "upstream_impacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.agent/automations/radar/cache/github/content-review-pairs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}--[0-9a-f]{64}--[0-9a-f]{64}/impact\\.json$"
          }
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "release_deltas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "evidence_digests": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[^/](?:.*\\.json)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "evidence_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence", "confidence"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "Exact value of one entry declared in source_refs."
          },
          "confidence": {
            "type": "string",
            "enum": ["confirmed", "likely", "weak"]
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worthiness", "reason", "idempotency_key"],
      "properties": {
        "worthiness": {
          "type": "string",
          "enum": ["publish", "skip"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "worthiness": {
                "const": "publish"
              }
            },
            "required": ["worthiness"]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "required": [
          "radar_eligibility",
          "radar_source_refs",
          "text_segments"
        ],
        "properties": {
          "candidate_text": {
            "maxItems": 1,
            "items": {
              "type": "string",
              "minLength": 80,
              "maxLength": 260
            }
          },
          "decision": {
            "properties": {
              "idempotency_key": {
                "pattern": "^radar-publication:[0-9a-f]{64}$"
              }
            }
          },
          "source_refs": {
            "required": [
              "upstream_reviews",
              "upstream_impacts"
            ],
            "properties": {
              "upstream_reviews": {
                "maxItems": 1
              },
              "upstream_impacts": {
                "maxItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_refs": {
            "anyOf": [
              {"required": ["upstream_reviews"]},
              {"required": ["upstream_impacts"]},
              {"required": ["signals"]},
              {"required": ["release_deltas"]}
            ]
          }
        },
        "required": ["source_refs"]
      },
      "then": {
        "required": ["evidence_digests"]
      }
    }
  ]
}
