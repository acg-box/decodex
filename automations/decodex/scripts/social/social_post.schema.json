{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decodex social post publication record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slug",
    "channel",
    "target_account",
    "owner",
    "mode",
    "status",
    "audience",
    "text",
    "source_refs",
    "evidence_notes",
    "claims",
    "decision"
  ],
  "properties": {
    "schema": {
      "const": "social_post/v1"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "const": "x"
    },
    "target_account": {
      "const": "decodexspace"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_id", "run_id"],
      "properties": {
        "automation_id": {
          "const": "decodex-xurl-publisher"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        }
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "release_pulse",
        "release_rollup",
        "practical_explainer",
        "operator_impact",
        "watch_note"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["published", "blocked", "failed", "skipped"]
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "Runtime validation also requires at most 260 conservative twitter-text v3 weighted characters.",
        "minLength": 1,
        "maxLength": 260,
        "allOf": [
          {
            "not": {
              "pattern": "Automated by @hackink"
            }
          },
          {
            "not": {
              "pattern": "^\\s*([Ww][Aa][Tt][Cc][Hh][Ii][Nn][Gg] [Tt][Hh][Ii][Ss]\\.?|[Tt][Rr][Aa][Cc][Kk][Ii][Nn][Gg] [Tt][Hh][Ii][Ss]\\.|.*[Nn][Ee][Ww] [Rr][Ee][Ll][Ee][Aa][Ss][Ee] [Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee].*)"
            }
          },
          {
            "not": {
              "pattern": "(https?://|www\\.)"
              }
          }
        ]
      }
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["reservations"]
        },
        {
          "required": ["release_deltas"]
        },
        {
          "required": ["social_candidates"]
        },
        {
          "required": ["signals"]
        },
        {
          "required": ["upstream_impacts"]
        },
        {
          "required": ["upstream_reviews"]
        },
        {
          "required": ["urls"]
        }
      ],
      "properties": {
        "reservations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "release_deltas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "social_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "upstream_impacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.agent/automations/radar/cache/github/content-review-pairs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}--[0-9a-f]{64}--[0-9a-f]{64}/impact\\.json$"
          }
        },
        "upstream_reviews": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.agent/automations/radar/cache/github/content-review-pairs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}--[0-9a-f]{64}--[0-9a-f]{64}/review\\.json$"
          }
        },
        "urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "evidence_digests": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[^/](?:.*\\.json)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "evidence_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence", "confidence"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "Exact value of one entry declared in source_refs or its one social_candidate source."
          },
          "confidence": {
            "type": "string",
            "enum": ["confirmed", "likely", "weak"]
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worthiness",
        "priority",
        "idempotency_key",
        "reason",
        "daily_limit",
        "daily_count_before",
        "daily_count_after",
        "day",
        "timezone"
      ],
      "properties": {
        "worthiness": {
          "type": "string",
          "enum": ["publish", "skip", "block"]
        },
        "priority": {
          "type": "string",
          "enum": ["critical", "high", "normal", "low"]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "daily_limit": {
          "const": 1
        },
        "daily_count_before": {
          "type": "integer",
          "minimum": 0
        },
        "daily_count_after": {
          "type": "integer",
          "minimum": 0
        },
        "day": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "posted_at",
        "published_urls",
        "post_id",
        "publisher",
        "xurl_version",
        "xurl_app",
        "verified_account",
        "verified_user_id",
        "account_verified",
        "made_with_ai",
        "identity_response_sha256",
        "create_response_sha256",
        "read_response_sha256",
        "publication_lineage_sha256",
        "recorded_cost_ceiling_microusd"
      ],
      "properties": {
        "posted_at": {
          "type": "string",
          "minLength": 1
        },
        "published_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://x\\.com/decodexspace/status/"
          }
        },
        "publisher": {
          "const": "xurl"
        },
        "post_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "xurl_version": {
          "const": "1.3.1"
        },
        "xurl_app": {
          "const": "default"
        },
        "verified_account": {
          "const": "decodexspace"
        },
        "verified_user_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "account_verified": {
          "const": true
        },
        "made_with_ai": {
          "type": "boolean"
        },
        "identity_response_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "create_response_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "read_response_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publication_lineage_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recorded_cost_ceiling_microusd": {
          "type": "integer",
          "enum": [30000, 35000, 40000]
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "operator_notice"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["daily_cap_exceeded", "duplicate", "policy_block", "insufficient_evidence"]
        },
        "operator_notice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "details"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "post_lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_state", "quote_eligible", "reason"],
      "properties": {
        "current_state": {
          "type": "string",
          "enum": [
            "live",
            "deleted_by_operator",
            "superseded_published",
            "superseded_text_only",
            "superseded_failed_attempt"
          ]
        },
        "quote_eligible": {
          "type": "boolean"
        },
        "superseded_by_candidate": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "quote_eligible": {
                "const": true
              }
            },
            "required": ["quote_eligible"]
          },
          "then": {
            "properties": {
              "current_state": {
                "const": "live"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "current_state": {
                "enum": [
                  "superseded_published",
                  "superseded_text_only",
                  "superseded_failed_attempt"
                ]
              }
            },
            "required": ["current_state"]
          },
          "then": {
            "required": ["superseded_by_candidate"]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "required": ["publication"],
        "properties": {
          "text": {
            "maxItems": 1,
            "items": {
              "type": "string",
              "minLength": 80,
              "maxLength": 260
            }
          },
          "source_refs": {
            "type": "object",
            "required": ["reservations", "social_candidates"],
            "properties": {
              "reservations": {
                "maxItems": 1
              },
              "social_candidates": {
                "maxItems": 1
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {"required": ["block"]},
            {"required": ["failure"]},
            {"required": ["skip"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_refs": {
            "anyOf": [
              {"required": ["upstream_reviews"]},
              {"required": ["upstream_impacts"]},
              {"required": ["signals"]},
              {"required": ["release_deltas"]}
            ]
          }
        },
        "required": ["source_refs"]
      },
      "then": {
        "required": ["evidence_digests"]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": ["block"],
        "not": {
          "anyOf": [
            {"required": ["publication"]},
            {"required": ["failure"]},
            {"required": ["skip"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": ["failure"],
        "not": {
          "anyOf": [
            {"required": ["publication"]},
            {"required": ["block"]},
            {"required": ["skip"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "skipped"
          }
        }
      },
      "then": {
        "required": ["skip"],
        "not": {
          "anyOf": [
            {"required": ["publication"]},
            {"required": ["block"]},
            {"required": ["failure"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "post_lifecycle": {
            "properties": {
              "quote_eligible": {
                "const": true
              }
            },
            "required": ["quote_eligible"]
          }
        },
        "required": ["post_lifecycle"]
      },
      "then": {
        "properties": {
          "status": {
            "const": "published"
          }
        }
      }
    }
  ]
}
