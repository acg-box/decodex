{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decodex social post outcome record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slug",
    "target_account",
    "owner",
    "social_post_ref",
    "published_url",
    "observed_at",
    "window",
    "metrics",
    "observation"
  ],
  "properties": {
    "schema": {
      "const": "social_outcome/v1"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "target_account": {
      "const": "decodexspace"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_id", "run_id"],
      "properties": {
        "automation_id": {
          "const": "decodex-xurl-publisher"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        }
      }
    },
    "social_post_ref": {
      "type": "string",
      "minLength": 1
    },
    "published_url": {
      "type": "string",
      "pattern": "^https://x\\.com/decodexspace/status/"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "window": {
      "type": "string",
      "enum": ["24h", "7d"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "views": {
          "type": "integer",
          "minimum": 0
        },
        "likes": {
          "type": "integer",
          "minimum": 0
        },
        "replies": {
          "type": "integer",
          "minimum": 0
        },
        "reposts": {
          "type": "integer",
          "minimum": 0
        },
        "bookmarks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader",
        "xurl_version",
        "xurl_app",
        "verified_account",
        "publication_lineage_sha256",
        "response_sha256",
        "recorded_cost_ceiling_microusd"
      ],
      "properties": {
        "reader": {
          "const": "xurl"
        },
        "xurl_version": {
          "const": "1.3.1"
        },
        "xurl_app": {
          "const": "default"
        },
        "verified_account": {
          "const": "decodexspace"
        },
        "publication_lineage_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recorded_cost_ceiling_microusd": {
          "const": 5000
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
