{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decodex bounded social strategy review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cycle_key",
    "cadence",
    "reviewed_at",
    "evidence_refs",
    "decisions",
    "guardrails",
    "next_review_at"
  ],
  "properties": {
    "schema": {
      "const": "social_strategy/v1"
    },
    "cycle_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cadence": {
      "type": "string",
      "enum": ["daily", "weekly"]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "key",
          "previous_value",
          "next_value",
          "reason"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "topic_weight",
              "format_preference",
              "quality_threshold",
              "no_change"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "previous_value": {
            "$ref": "#/$defs/strategyValue"
          },
          "next_value": {
            "$ref": "#/$defs/strategyValue"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "editorial_benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observations"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "deferred"
          ]
        },
        "public_post_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^https://x\\.com/(CodexReleases|Codex_Changelog|decodexspace)/status/[0-9]+$"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "public_post_urls"
            ],
            "not": {
              "required": [
                "reason_code"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "deferred"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason_code"
            ],
            "not": {
              "required": [
                "public_post_urls"
              ]
            }
          }
        }
      ]
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_gate",
        "privacy_gate",
        "idempotency_gate",
        "account_gate",
        "publication_gate"
      ],
      "properties": {
        "evidence_gate": {
          "const": "unchanged"
        },
        "privacy_gate": {
          "const": "unchanged"
        },
        "idempotency_gate": {
          "const": "unchanged"
        },
        "account_gate": {
          "const": "unchanged"
        },
        "publication_gate": {
          "const": "unchanged"
        }
      }
    },
    "next_review_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cadence": {
            "const": "weekly"
          }
        },
        "required": [
          "cadence"
        ]
      },
      "then": {
        "required": [
          "editorial_benchmark"
        ],
        "properties": {
          "decisions": {
            "contains": {
              "type": "object",
              "properties": {
                "key": {
                  "const": "weekly_editorial_benchmark"
                }
              },
              "required": [
                "key"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "allOf": [
          {
            "not": {
              "required": [
                "editorial_benchmark"
              ]
            }
          },
          {
            "properties": {
              "decisions": {
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "const": "weekly_editorial_benchmark"
                      }
                    },
                    "required": [
                      "key"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "strategyValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      ]
    }
  }
}
