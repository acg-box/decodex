{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radar content eligibility lineage receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repo",
    "subject_kind",
    "subject_id",
    "slug",
    "upstream_head",
    "commit_shas",
    "queue_sha256",
    "review_sha256",
    "impact_sha256",
    "lineage_sha256"
  ],
  "properties": {
    "schema": {
      "const": "radar_content_eligibility/v1"
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "subject_kind": {
      "type": "string",
      "enum": ["commit", "pr"]
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "upstream_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "commit_shas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
      }
    },
    "queue_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "impact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lineage_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
