{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Radar content-review pair commit report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "pair_dir",
    "review_path",
    "impact_path",
    "staging_sha256",
    "review_sha256",
    "impact_sha256"
  ],
  "properties": {
    "schema": {
      "const": "radar_content_review_pair_commit/v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "committed",
        "recovered"
      ]
    },
    "pair_dir": {
      "type": "string",
      "pattern": "^github/content-review-pairs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}--[0-9a-f]{64}--[0-9a-f]{64}$"
    },
    "review_path": {
      "type": "string",
      "pattern": "^github/content-review-pairs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}--[0-9a-f]{64}--[0-9a-f]{64}/review\\.json$"
    },
    "impact_path": {
      "type": "string",
      "pattern": "^github/content-review-pairs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}--[0-9a-f]{64}--[0-9a-f]{64}/impact\\.json$"
    },
    "staging_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "impact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
