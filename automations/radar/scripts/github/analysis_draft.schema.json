{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decodex GitHub analysis draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "title",
    "summary",
    "why_it_matters",
    "confidence",
    "impact",
    "proof_points",
    "slug",
    "config_flags",
    "how_to_try",
    "expected_effect",
    "caveats",
    "watch_state"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "capability",
        "behavior_change",
        "try_now"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "confirmed",
        "likely",
        "weak"
      ]
    },
    "impact": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "proof_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "slug": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "config_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "how_to_try": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "expected_effect": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "caveats": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "watch_state": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
