{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/plugins/cache/hack-ink/decodex/0.2.0/scripts/decodex_lifecycle_hook\" --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
