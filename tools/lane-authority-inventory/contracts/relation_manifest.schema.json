{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decodex.space/schemas/lane-authority-v2-c1i-relation-manifest-1.json",
  "$defs": {
    "digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "id": {"pattern": "^[a-z0-9][a-z0-9._:-]*$", "type": "string"},
    "language": {"enum": ["python", "rust", "shell", "swift", "toml", "yaml"]},
    "path": {"not": {"pattern": "^(?:/|[A-Za-z]:|.*\\.\\.)"}, "minLength": 1, "type": "string"},
    "rust_module_scope": {
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"scope_kind": {"const": "crate_root"}}, "required": ["scope_kind"]}, "then": {"properties": {"declaration_syntax_site_id": {"const": null}, "parent_scope_id": {"const": null}, "target_extern_crate_names": {"items": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "type": "string"}, "minItems": 4, "type": "array", "uniqueItems": true}, "target_kinds": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true}, "target_manifest_path": {"$ref": "#/$defs/path"}, "target_name": {"minLength": 1, "type": "string"}, "target_root_path": {"$ref": "#/$defs/path"}, "target_root_source_node_id": {"$ref": "#/$defs/id"}}}},
        {"if": {"properties": {"scope_kind": {"enum": ["file_module", "inline_module"]}}, "required": ["scope_kind"]}, "then": {"properties": {"declaration_syntax_site_id": {"$ref": "#/$defs/id"}, "parent_scope_id": {"$ref": "#/$defs/id"}, "target_extern_crate_names": {"const": null}, "target_kinds": {"const": null}, "target_manifest_path": {"const": null}, "target_name": {"const": null}, "target_root_path": {"const": null}, "target_root_source_node_id": {"const": null}}}},
        {"if": {"properties": {"scope_kind": {"const": "block"}}, "required": ["scope_kind"]}, "then": {"properties": {"declaration_syntax_site_id": {"const": null}, "parent_scope_id": {"$ref": "#/$defs/id"}, "target_extern_crate_names": {"const": null}, "target_kinds": {"const": null}, "target_manifest_path": {"const": null}, "target_name": {"const": null}, "target_root_path": {"const": null}, "target_root_source_node_id": {"const": null}}}}
      ],
      "properties": {
        "byte_end": {"minimum": 0, "type": "integer"},
        "byte_start": {"minimum": 0, "type": "integer"},
        "canonical_module_path": {"minLength": 1, "maxLength": 512, "type": "string"},
        "cfg_projection_ids": {"items": {"$ref": "#/$defs/id"}, "minItems": 1, "type": "array", "uniqueItems": true},
        "crate_target_id": {"$ref": "#/$defs/id"},
        "declaration_syntax_site_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "parent_scope_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "scope_id": {"$ref": "#/$defs/id"},
        "scope_kind": {"enum": ["crate_root", "file_module", "inline_module", "block"]},
        "scope_syntax_site_id": {"$ref": "#/$defs/id"},
        "source_node_id": {"$ref": "#/$defs/id"},
        "target_manifest_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "target_extern_crate_names": {"anyOf": [{"items": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "type": "string"}, "type": "array", "uniqueItems": true}, {"type": "null"}]},
        "target_kinds": {"anyOf": [{"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true}, {"type": "null"}]},
        "target_name": {"type": ["string", "null"]},
        "target_root_path": {"anyOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
        "target_root_source_node_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      },
      "required": ["scope_id", "crate_target_id", "source_node_id", "scope_syntax_site_id", "parent_scope_id", "scope_kind", "canonical_module_path", "byte_start", "byte_end", "declaration_syntax_site_id", "cfg_projection_ids", "target_extern_crate_names", "target_manifest_path", "target_kinds", "target_name", "target_root_path", "target_root_source_node_id"],
      "type": "object"
    },
    "rust_name_binding": {
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"binding_kind": {"enum": ["module", "type_declaration"]}}, "required": ["binding_kind"]}, "then": {"properties": {"surface_target_path": {"const": null}}}, "else": {"properties": {"surface_target_path": {"minLength": 1, "maxLength": 512, "type": "string"}}}},
        {"if": {"properties": {"visibility": {"const": "in"}}, "required": ["visibility"]}, "then": {"properties": {"visibility_path": {"minLength": 1, "maxLength": 512, "type": "string"}}}, "else": {"properties": {"visibility_path": {"const": null}}}},
        {"if": {"properties": {"resolution": {"enum": ["external", "unresolved", "ambiguous", "unsupported"]}}, "required": ["resolution"]}, "then": {"properties": {"target_scope_id": {"const": null}, "target_symbol_site_id": {"const": null}}}},
        {"if": {"properties": {"binding_kind": {"const": "module"}, "resolution": {"const": "resolved"}}, "required": ["binding_kind", "resolution"]}, "then": {"properties": {"target_scope_id": {"$ref": "#/$defs/id"}, "target_symbol_site_id": {"const": null}}}},
        {"if": {"properties": {"binding_kind": {"const": "type_declaration"}, "resolution": {"const": "resolved"}}, "required": ["binding_kind", "resolution"]}, "then": {"properties": {"target_scope_id": {"const": null}, "target_symbol_site_id": {"$ref": "#/$defs/id"}}}},
        {"if": {"properties": {"binding_kind": {"enum": ["use", "reexport"]}, "resolution": {"const": "resolved"}}, "required": ["binding_kind", "resolution"]}, "then": {"oneOf": [{"properties": {"target_scope_id": {"$ref": "#/$defs/id"}, "target_symbol_site_id": {"const": null}}}, {"properties": {"target_scope_id": {"const": null}, "target_symbol_site_id": {"$ref": "#/$defs/id"}}}]}}
      ],
      "properties": {
        "binding_id": {"$ref": "#/$defs/id"},
        "binding_kind": {"enum": ["module", "type_declaration", "use", "reexport", "glob"]},
        "crate_target_id": {"$ref": "#/$defs/id"},
        "local_name": {"minLength": 1, "maxLength": 256, "type": "string"},
        "namespace": {"const": "type"},
        "reason_code": {"enum": ["rust_binding_exact_module_declaration", "rust_binding_exact_type_declaration", "rust_binding_exact_path_resolution", "rust_binding_external_path", "rust_binding_path_ambiguous", "rust_binding_path_unsupported", "rust_binding_path_target_unresolved", "rust_binding_path_resolution_pending", "rust_binding_module_target_unresolved", "rust_binding_type_symbol_unresolved", "rust_binding_ambiguous_module_declaration", "rust_binding_ambiguous_type_declaration", "rust_binding_same_scope_ambiguous", "rust_binding_glob_unsupported", "rust_binding_visibility_unsupported"]},
        "resolution": {"enum": ["resolved", "external", "unresolved", "ambiguous", "unsupported"]},
        "scope_id": {"$ref": "#/$defs/id"},
        "source_node_id": {"$ref": "#/$defs/id"},
        "surface_target_path": {"type": ["string", "null"], "maxLength": 512},
        "syntax_site_id": {"$ref": "#/$defs/id"},
        "target_scope_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "target_symbol_site_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "visibility": {"enum": ["private", "public", "crate", "super", "in", "unsupported"]},
        "visibility_path": {"type": ["string", "null"], "maxLength": 512}
      },
      "required": ["binding_id", "binding_kind", "crate_target_id", "scope_id", "source_node_id", "syntax_site_id", "local_name", "namespace", "surface_target_path", "visibility", "visibility_path", "target_scope_id", "target_symbol_site_id", "resolution", "reason_code"],
      "type": "object"
    },
    "rust_path_resolution": {
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"purpose": {"const": "binding_target"}}, "required": ["purpose"]}, "then": {"properties": {"source_binding_id": {"$ref": "#/$defs/id"}, "source_symbol_site_id": {"const": null}}}},
        {"if": {"properties": {"status": {"const": "resolved_local_module"}}, "required": ["status"]}, "then": {"properties": {"canonical_module_scope_id": {"$ref": "#/$defs/id"}, "canonical_path": {"minLength": 1, "maxLength": 512, "type": "string"}, "canonical_type_definition_site_id": {"const": null}}}},
        {"if": {"properties": {"status": {"const": "resolved_local_type"}}, "required": ["status"]}, "then": {"properties": {"canonical_module_scope_id": {"const": null}, "canonical_path": {"minLength": 1, "maxLength": 512, "type": "string"}, "canonical_type_definition_site_id": {"$ref": "#/$defs/id"}}}},
        {"if": {"properties": {"status": {"const": "external"}}, "required": ["status"]}, "then": {"properties": {"canonical_module_scope_id": {"const": null}, "canonical_path": {"minLength": 1, "maxLength": 512, "type": "string"}, "canonical_type_definition_site_id": {"const": null}}}},
        {"if": {"properties": {"status": {"enum": ["ambiguous", "cycle", "unresolved", "unsupported"]}}, "required": ["status"]}, "then": {"properties": {"canonical_module_scope_id": {"const": null}, "canonical_path": {"const": null}, "canonical_type_definition_site_id": {"const": null}}}}
      ],
      "properties": {
        "binding_ids": {"items": {"$ref": "#/$defs/id"}, "minItems": 1, "type": "array"},
        "canonical_module_scope_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "canonical_path": {"type": ["string", "null"], "maxLength": 512},
        "canonical_type_definition_site_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "crate_target_id": {"$ref": "#/$defs/id"},
        "lexical_scope_id": {"$ref": "#/$defs/id"},
        "namespace": {"const": "type"},
        "purpose": {"enum": ["binding_target"]},
        "reason_code": {"enum": ["rust_path_ambiguous_binding", "rust_path_reexport_cycle", "rust_path_external_crate", "rust_path_unique_local_module", "rust_path_unique_local_type", "rust_path_target_unresolved", "rust_path_unsupported_construct"]},
        "resolution_digest": {"$ref": "#/$defs/digest"},
        "resolution_id": {"$ref": "#/$defs/id"},
        "source_binding_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "source_symbol_site_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "status": {"enum": ["resolved_local_module", "resolved_local_type", "external", "ambiguous", "cycle", "unresolved", "unsupported"]},
        "surface_path": {"minLength": 1, "maxLength": 512, "type": "string"}
      },
      "required": ["resolution_id", "purpose", "crate_target_id", "lexical_scope_id", "namespace", "surface_path", "canonical_path", "canonical_module_scope_id", "canonical_type_definition_site_id", "source_binding_id", "source_symbol_site_id", "binding_ids", "status", "reason_code", "resolution_digest"],
      "type": "object"
    },
    "source_node": {
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "deleted"}}, "required": ["status"]}, "then": {"properties": {"parser_error_count": {"const": 0}, "parser_node_count": {"const": 0}, "parser_receipt_id": {"const": null}, "syntax_site_count": {"const": 0}, "zero_syntax_reason_code": {"const": "deleted_tombstone"}}}},
        {"if": {"properties": {"status": {"const": "current"}}, "required": ["status"]}, "then": {"properties": {"parser_node_count": {"minimum": 1}, "parser_receipt_id": {"$ref": "#/$defs/id"}, "syntax_site_count": {"minimum": 1}, "zero_syntax_reason_code": {"const": null}}}}
      ],
      "properties": {
        "byte_length": {"minimum": 0, "type": "integer"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "language": {"enum": ["python", "rust", "shell", "swift", "toml", "yaml"]},
        "parser_receipt_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "parser_error_count": {"minimum": 0, "type": "integer"},
        "parser_node_count": {"minimum": 0, "type": "integer"},
        "parser_node_digest": {"$ref": "#/$defs/digest"},
        "path": {"$ref": "#/$defs/path"},
        "predecessor_source_node_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "provenance": {"enum": ["c0", "post_c0_base", "c1i_head", "tool", "deleted_tombstone"]},
        "scope": {"enum": ["production", "test", "mixed", "generated", "tool"]},
        "source_node_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["current", "deleted"]},
        "syntax_site_count": {"minimum": 0, "type": "integer"},
        "syntax_site_ids_digest": {"$ref": "#/$defs/digest"},
        "zero_syntax_reason_code": {"type": ["string", "null"]}
      },
      "required": ["source_node_id", "path", "byte_length", "content_digest", "language", "scope", "provenance", "status", "predecessor_source_node_id", "parser_receipt_id", "parser_error_count", "parser_node_count", "parser_node_digest", "syntax_site_count", "syntax_site_ids_digest", "zero_syntax_reason_code"],
      "type": "object"
    },
    "syntax_site": {
      "additionalProperties": false,
      "properties": {
        "byte_end": {"minimum": 0, "type": "integer"},
        "byte_start": {"minimum": 0, "type": "integer"},
        "is_parser_root": {"type": "boolean"},
        "node_kind": {"minLength": 1, "type": "string"},
        "recovery_state": {"enum": ["clean", "error", "missing"]},
        "site_id": {"$ref": "#/$defs/id"},
        "source_node_id": {"$ref": "#/$defs/id"}
      },
      "required": ["site_id", "source_node_id", "byte_start", "byte_end", "node_kind", "is_parser_root", "recovery_state"],
      "type": "object"
    },
    "symbol_site": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"resolution": {"const": "declaration"}}, "required": ["resolution"]},
          "then": {"properties": {"definition_site_ids": {"maxItems": 0}, "external": {"const": false}, "role": {"const": "declaration"}}}
        },
        {
          "if": {"properties": {"resolution": {"const": "local"}}, "required": ["resolution"]},
          "then": {"properties": {"definition_site_ids": {"minItems": 1}, "external": {"const": false}, "role": {"const": "call_target"}}}
        },
        {
          "if": {"properties": {"resolution": {"const": "external"}}, "required": ["resolution"]},
          "then": {"properties": {"definition_site_ids": {"maxItems": 0}, "external": {"const": true}, "role": {"const": "call_target"}}}
        },
        {
          "if": {"properties": {"resolution": {"const": "unresolved"}}, "required": ["resolution"]},
          "then": {"properties": {"definition_site_ids": {"maxItems": 0}, "external": {"const": null}, "role": {"const": "call_target"}}}
        },
        {
          "if": {"properties": {"receiver_type_evidence": {"type": "string"}}, "required": ["receiver_type_evidence"]},
          "then": {"properties": {"language": {"const": "rust"}, "receiver_type_signature": {"minLength": 1, "type": "string"}, "resolution_hint": {"const": "qualified"}, "role": {"const": "call_target"}}},
          "else": {"properties": {"receiver_type_signature": {"const": null}}}
        }
      ],
      "properties": {
        "definition_site_ids": {"items": {"$ref": "#/$defs/id"}, "type": "array", "uniqueItems": true},
        "external": {"type": ["boolean", "null"]},
        "language": {"$ref": "#/$defs/language"},
        "owner_signature": {"type": ["string", "null"], "maxLength": 256},
        "receiver_type_evidence": {"enum": ["enclosing_struct_field_type", "explicit_local_type", "explicit_parameter_type", null]},
        "receiver_type_signature": {"maxLength": 256, "type": ["string", "null"]},
        "resolution": {"enum": ["declaration", "local", "external", "unresolved"]},
        "resolution_hint": {"enum": ["dynamic", "exact", "qualified"]},
        "role": {"enum": ["declaration", "call_target"]},
        "signature": {"minLength": 1, "maxLength": 256, "type": "string"},
        "signature_digest": {"$ref": "#/$defs/digest"},
        "site_id": {"$ref": "#/$defs/id"},
        "syntax_site_id": {"$ref": "#/$defs/id"}
      },
      "required": ["site_id", "syntax_site_id", "language", "owner_signature", "receiver_type_evidence", "receiver_type_signature", "role", "signature", "signature_digest", "resolution_hint", "resolution", "definition_site_ids", "external"],
      "type": "object"
    },
    "data_site": {
      "additionalProperties": false,
      "properties": {
        "data_kind": {"enum": ["config", "environment", "filesystem", "provider", "serialization", "sql"]},
        "site_id": {"$ref": "#/$defs/id"},
        "syntax_site_id": {"$ref": "#/$defs/id"}
      },
      "required": ["site_id", "syntax_site_id", "data_kind"],
      "type": "object"
    },
    "edge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {"$ref": "#/$defs/id"},
        "from_site_id": {"$ref": "#/$defs/id"},
        "to_site_id": {"$ref": "#/$defs/id"}
      },
      "required": ["edge_id", "from_site_id", "to_site_id"],
      "type": "object"
    },
    "candidate_record": {
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"provenance": {"const": "c0_replay"}}, "required": ["provenance"]}, "then": {"properties": {"c0_observation_ids": {"minItems": 1}, "c0_origin_artifacts": {"minItems": 1}}}},
        {"if": {"properties": {"provenance": {"const": "post_c0"}}, "required": ["provenance"]}, "then": {"properties": {"c0_observation_ids": {"maxItems": 0}, "c0_origin_artifacts": {"maxItems": 0}}}}
      ],
      "properties": {
        "candidate_category": {"minLength": 1, "type": "string"},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "candidate_id": {"$ref": "#/$defs/id"},
        "c0_origin_artifacts": {"items": {"enum": ["launcher", "legacy", "mutation"]}, "type": "array", "uniqueItems": true},
        "c0_observation_ids": {"items": {"$ref": "#/$defs/id"}, "type": "array", "uniqueItems": true},
        "line_digest": {"$ref": "#/$defs/digest"},
        "line_number": {"minimum": 1, "type": "integer"},
        "provenance": {"enum": ["c0_replay", "post_c0"]},
        "source_node_id": {"$ref": "#/$defs/id"}
      },
      "required": ["candidate_id", "source_node_id", "candidate_category", "line_number", "line_digest", "candidate_digest", "provenance", "c0_origin_artifacts", "c0_observation_ids"],
      "type": "object"
    },
    "candidate_site_edge": {
      "additionalProperties": false,
      "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "edge_digest": {"$ref": "#/$defs/digest"}, "site_id": {"$ref": "#/$defs/id"}},
      "required": ["candidate_id", "site_id", "edge_digest"],
      "type": "object"
    },
    "candidate_adjudication": {
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "covered_by_sites"}}, "required": ["disposition"]}, "then": {"properties": {"related_site_ids": {"minItems": 1}}}},
        {"if": {"properties": {"disposition": {"enum": ["regex_false_positive", "declarative_document", "supporting_input", "deleted_since_c0"]}}, "required": ["disposition"]}, "then": {"properties": {"related_site_ids": {"maxItems": 0}}}}
      ],
      "properties": {
        "candidate_category": {"minLength": 1, "type": "string"},
        "candidate_id": {"$ref": "#/$defs/id"},
        "disposition": {"enum": ["covered_by_sites", "regex_false_positive", "declarative_document", "supporting_input", "deleted_since_c0"]},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "reason_code": {"pattern": "^(?!.*(?:unknown|unresolved|pending|todo|missing|error))[a-z0-9][a-z0-9._:-]*$", "type": "string"},
        "related_site_ids": {"items": {"$ref": "#/$defs/id"}, "type": "array", "uniqueItems": true},
        "review_receipt_digest": {"$ref": "#/$defs/digest"}
      },
      "required": ["candidate_id", "candidate_category", "related_site_ids", "disposition", "evidence_digest", "reason_code", "review_receipt_digest"],
      "type": "object"
    },
    "cfg_projection": {
      "additionalProperties": false,
      "properties": {
        "cfg_expression_digest": {"$ref": "#/$defs/digest"},
        "disposition": {"enum": ["active_supported", "inactive_supported_projection", "unsupported_by_product_contract", "generated_from_bound_input"]},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "language": {"enum": ["python", "rust", "shell", "swift", "toml", "yaml"]},
        "platform": {"enum": ["common", "linux", "macos"]},
        "projection_id": {"$ref": "#/$defs/id"},
        "projection_kind": {"enum": ["config", "target"]},
        "site_id": {"$ref": "#/$defs/id"}
      },
      "required": ["projection_id", "projection_kind", "site_id", "language", "platform", "cfg_expression_digest", "disposition", "evidence_digest"],
      "type": "object"
    },
    "site_classification": {
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"authority_relevance": {"const": "authority_surface"}}, "required": ["authority_relevance"]}, "then": {"properties": {"owner": {"minLength": 1, "type": "string"}, "ownership": {"enum": ["registered_adapter", "legacy_direct"]}, "removal_checkpoint": {"minLength": 1, "type": "string"}, "replacement_kind": {"minLength": 1, "type": "string"}}}},
        {"if": {"properties": {"authority_relevance": {"const": "reviewed_non_authority"}}, "required": ["authority_relevance"]}, "then": {"properties": {"owner": {"const": null}, "ownership": {"const": "not_applicable"}, "removal_checkpoint": {"const": null}, "replacement_kind": {"const": null}}}}
      ],
      "properties": {
        "authority_relevance": {"enum": ["authority_surface", "reviewed_non_authority"]},
        "owner": {"type": ["string", "null"]},
        "ownership": {"enum": ["registered_adapter", "legacy_direct", "not_applicable"]},
        "reason_code": {"pattern": "^(?!.*(?:unknown|unresolved|pending|todo|missing|error))[a-z0-9][a-z0-9._:-]*$", "type": "string"},
        "removal_checkpoint": {"type": ["string", "null"]},
        "replacement_kind": {"type": ["string", "null"]},
        "runtime_generation": {"enum": ["v12", "v2", "not_runtime"]},
        "scope": {"enum": ["production", "test", "mixed", "generated", "tool"]},
        "semantic_kinds": {"items": {"enum": ["mutation", "authority_read", "authority_discovery", "launcher", "data_only", "declarative_executable"]}, "minItems": 1, "type": "array", "uniqueItems": true},
        "site_id": {"$ref": "#/$defs/id"}
        ,
        "config_projection": {"$ref": "#/$defs/id"},
        "target_projection": {"$ref": "#/$defs/id"}
      },
      "required": ["site_id", "scope", "semantic_kinds", "runtime_generation", "authority_relevance", "ownership", "owner", "replacement_kind", "removal_checkpoint", "reason_code", "target_projection", "config_projection"],
      "type": "object"
    },
    "catalog_entry_disposition": {
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "matched_site"}}, "required": ["disposition"]}, "then": {"properties": {"site_id": {"$ref": "#/$defs/id"}}}},
        {"if": {"properties": {"disposition": {"const": "reviewed_absent"}}, "required": ["disposition"]}, "then": {"properties": {"site_id": {"const": null}}}}
      ],
      "properties": {
        "catalog_entry_id": {"$ref": "#/$defs/id"},
        "disposition": {"enum": ["matched_site", "reviewed_absent"]},
        "disposition_id": {"$ref": "#/$defs/id"},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "reason_code": {"pattern": "^(?!.*(?:unknown|unresolved|pending|todo|missing|error))[a-z0-9][a-z0-9._:-]*$", "type": "string"},
        "site_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      },
