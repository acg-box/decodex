{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decodex.space/schemas/lane-authority-v2-c1i-output-artifact-manifest-1.json",
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "accepted_authority": {"type": "boolean"},
        "binding": {"enum": ["artifact_sha256", "composition_relation_receipt", "exact_head_gate", "diagnostic_only"]},
        "path": {"pattern": "^(?:openwiki/evidence|tools/lane-authority-inventory)/(?!.*\\.\\.)[a-zA-Z0-9_./-]+$", "type": "string"},
        "role": {"enum": ["analysis_cut", "cfg_coverage", "composition", "dataflow_proof", "ledger", "relation", "rejection_report", "review_receipt", "tool_receipt"]}
      },
      "required": ["path", "role", "binding", "accepted_authority"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {"items": {"$ref": "#/$defs/artifact"}, "minItems": 21, "type": "array"},
    "schema": {"const": "decodex/lane-authority-v2-c1i-output-artifact-manifest/1"},
    "status": {"const": "p0_policy_only_incomplete"}
  },
  "required": ["schema", "status", "artifacts"],
  "title": "Lane Authority v2 C1I output artifact closure",
  "type": "object"
}
